{
  "name": "effisendtdc",
  "main": "expo-router/entry",
  "version": "1.0.57",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "webbuild": "npx expo export -p web",
    "webdeploy": "npx expo export -p web && eas deploy",
    "webprod": "npx expo export -p web && eas deploy --prod",
    "webserve": "npx expo export -p web && npx expo serve",
    "predeploy": "npm version patch --no-git-tag-version && node scripts/sync-version.js",
    "step:1": "powershell -ExecutionPolicy Bypass -File scripts/step1-webprod.ps1",
    "step:2": "powershell -ExecutionPolicy Bypass -File scripts/step2-update.ps1",
    "step:3": "powershell -ExecutionPolicy Bypass -File scripts/step3-build.ps1",
    "step:4": "powershell -ExecutionPolicy Bypass -File scripts/step4-install.ps1",
    "step:all": "npm run step:1 && npm run step:2 && npm run step:3 && npm run step:4",
    "build": "npm run step:3",
    "twa:update": "npm run step:2",
    "apk:install": "npm run step:4"
  },
  "dependencies": {
    "@expo-google-fonts/exo-2": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@metaplex-foundation/mpl-token-metadata-kit": "^0.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/hooks": "^100.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@solana-program/address-lookup-table": "^0.11.0",
    "@solana-program/compute-budget": "^0.15.0",
    "@solana-program/system": "^0.12.0",
    "@solana-program/token": "^0.13.0",
    "@solana/kit": "^6.8.0",
    "@tanstack/react-query": "^5.90.20",
    "buffer": "^6.0.3",
    "ethers": "^6.16.0",
    "expo": "~54.0.33",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
